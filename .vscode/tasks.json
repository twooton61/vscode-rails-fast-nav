// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "webpack",
            "options": {
                "env": {
                    "NODE_OPTIONS": "--openssl-legacy-provider"
                }
            },
            "problemMatcher": "$tsc",
            "group": "build"
        },
        {
            "label": "Package Extension",
            "type": "shell",
            "command": "npm run vscode:prepublish && npx vsce package -o rails-fast-nav-dev.vsix",
            "options": {
                "env": {
                    "NODE_OPTIONS": "--openssl-legacy-provider"
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Install Extension",
            "type": "shell",
            "command": "code --install-extension rails-fast-nav-dev.vsix --force",
            "options": {
                "env": {
                    "NODE_OPTIONS": "--openssl-legacy-provider"
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Package and Install Extension",
            "type": "shell",
            "command": "npm run vscode:prepublish && npx vsce package -o rails-fast-nav-dev.vsix && code --install-extension rails-fast-nav-dev.vsix --force",
            "options": {
                "env": {
                    "NODE_OPTIONS": "--openssl-legacy-provider"
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
    ]
}